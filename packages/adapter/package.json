{
  "name": "@nextgin/adapter",
  "version": "0.1.0",
  "description": "Next.js deployment adapter that emits a manifest + headless UDS worker for the nextgin Go/Gin runtime",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./adapter": "./dist/adapter.js"
  },
  "bin": {
    "nextgin": "./dist/cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "next": ">=16.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "next": "16.4.6",
    "typescript": "^5.6.0"
  }
}
