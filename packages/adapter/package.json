{
  "name": "@nextgin/adapter",
  "version": "0.1.0",
  "description": "Next.js build adapter and CLI for the zero-dependency pure-Go nextgin runtime",
  "homepage": "https://next-gin.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chidi09/nextgin.git",
    "directory": "packages/adapter"
  },
  "keywords": [
    "nextgin",
    "nextjs",
    "go",
    "golang",
    "adapter",
    "selfhost",
    "vercel",
    "cron"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./adapter": "./dist/adapter.js"
  },
  "bin": {
    "nextgin": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "next": ">=16.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "next": "16.4.6",
    "typescript": "^5.6.0"
  }
}
